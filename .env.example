# Environment Variables for VirtualCare Mobile App
# Copy this file to .env and fill in your real values.
# NEVER commit .env to git.

# ─── Firebase Web SDK Config ─────────────────────────────────────────
# Found in: Firebase Console → Project Settings → Your Apps → Web App
EXPO_PUBLIC_FIREBASE_API_KEY=your_api_key_here
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=123456789
EXPO_PUBLIC_FIREBASE_APP_ID=1:123456789:web:abcdef123456

# ─── Backend API URL ──────────────────────────────────────────────────
# Your Node.js/Express backend URL (local dev or production)
EXPO_PUBLIC_API_BASE_URL=http://localhost:3000/api

# NOTE: Do NOT add Gemini API key here.
# AI requests go through the backend, not directly from the mobile app.
