# ── VirtualCare Backend Environment Variables ──────────────────────
# Copy this file to backend/.env and fill in the real values.
# NEVER commit backend/.env to git.

PORT=3000

# Gemini API Key (from Google AI Studio: https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# Firebase Service Account (Server-side Admin SDK)
# 1. Go to Firebase Console > Project Settings > Service Accounts
# 2. Click "Generate new private key"
# 3. Download the JSON file
# 4. PASTE the entire JSON content as a single-line string here:
FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"...","private_key":"...","client_email":"..."}

# Firebase Storage Bucket (without gs://)
FIREBASE_STORAGE_BUCKET=your_storage_bucket_here
